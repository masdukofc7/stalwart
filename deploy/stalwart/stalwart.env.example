# /etc/stalwart/stalwart.env (owner root:stalwart, mode 0640)
#
# Keep this file empty in normal operation. STALWART_RECOVERY_ADMIN is accepted in every mode
# while set, so it is a permanent full-access login. Only add it to regain access, restart,
# fix the problem, then remove it and restart again.
#
# STALWART_RECOVERY_ADMIN=admin:<strong-temporary-password>
